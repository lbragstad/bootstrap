{{ ansible_managed | comment }}
[color]
	ui = true
	branch = true
	diff = true
	status = true
[user]
	email = {{ git_user_email }}
	name = {{ git_user_name }}
	signingkey = {{ git_signing_key }}
[core]
	editor = nvim
	excludesfile = {{ home }}/.gitignore_global
	pager = delta
[merge]
	tool = vimdiff
[gitreview]
	username = {{ git_review_username }}
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	d = diff
	l = log
[safe]
{% for directory in git_safe_directories %}
	directory = {{ directory }}
{% endfor %}
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[url "git@github.com:"]
	insteadOf = https://github.com/
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = {{ home }}/.config/git/allowed_signers
[delta]
	plus-style = syntax "#1a501a"
	plus-non-emph-style = syntax "#1a501a"
	plus-emph-style = syntax "#2a802a"
	plus-empty-line-marker-style = normal "#1a501a"
[interactive]
	diffFilter = delta --color-only
