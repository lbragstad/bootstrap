#!/bin/bash
# setup a tmux window as an IDE-style workspace tuned for a large screen:
# a wide workspace centered as the primary work surface, a thin column on the
# left for running an agent, and a utility column on the right split into the
# git, terminal, and spare panels nvim does not provide.

# peel a utility column off the right (~25% of the window)
tmux split-window -h -l 25%

# split the utility column into three even rows: git (top), a terminal drawer
# (middle), and a spare panel (bottom)
tmux split-window -v -l 67%
tmux split-window -v -l 50%

# move back into the wide left region and carve the agent column (left, ~25%)
# away from the centered workspace (~50% of the window)
tmux select-pane -L
workspace=$(tmux split-window -h -l 67% -P -F '#{pane_id}')

tmux rename-window desk

# label each pane border with its index and running command (window-scoped)
tmux set-window-option pane-border-status top
tmux set-window-option pane-border-format ' #{pane_index}: #{pane_current_command} '

# clear every pane and land on the centered workspace
for pane in $(tmux list-panes -F '#{pane_id}'); do
  tmux send-keys -t "$pane" "clear" Enter
done

tmux select-pane -t "$workspace"
