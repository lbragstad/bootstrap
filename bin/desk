#!/bin/bash
# setup a tmux window as an IDE-style workspace tuned for a large screen:
# two full-height columns for viewing large files side by side (nvim already
# provides its own file tree and fuzzy finder), plus a utility column split
# into the git and terminal panels nvim does not provide.

# editor column (left, 50%) and the work area (right, 50%)
tmux split-window -h -l 50%

# split the work area into a full-height viewer column and a utility column
tmux split-window -h -l 50%

# split the utility column into git (top) and a terminal drawer (bottom)
tmux split-window -v -l 50%

tmux rename-window desk

# label each pane border with its index and running command (window-scoped)
tmux set-window-option pane-border-status top
tmux set-window-option pane-border-format ' #{pane_index}: #{pane_current_command} '

# clear every pane and land on the editor
for pane in $(tmux list-panes -F '#{pane_index}'); do
  tmux send-keys -t "$pane" "clear" Enter
done

tmux select-pane -t 0
