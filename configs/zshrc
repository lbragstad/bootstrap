# Homebrew, on either an Apple silicon or an Intel Mac.
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [[ -x "$brew" ]] && eval "$("$brew" shellenv)" && break
done

export PATH=$HOME/bin:$HOME/dotfiles/bin:~/.local/bin:/usr/local/bin:$PATH
export PATH=$PATH:/usr/local/go/bin:$HOME/go/bin
export GOPATH=$HOME/go
export GOBIN=$HOME/go/bin

export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="solus"
plugins=(git history-substring-search virtualenv golang vi-mode gh)
source $ZSH/oh-my-zsh.sh

export GO111MODULE="on"
export EDITOR='nvim'

# Make the switch to neovim just a little easier for now
alias vi='nvim'

if [[ "$OSTYPE" == linux* ]]; then
  alias signal="flatpak run org.signal.Signal"
fi

# Load git completion for zsh and bash (which is a dependency for
# git-completion.zsh)
zstyle ':completion:*:*:git:*' script ~/.zsh/git-completion.bash
fpath=(~/.zsh $fpath)
autoload -Uz compinit && compinit

# gcloud completion. The rpm ships it under /usr/share, the Homebrew cask under
# the brew prefix. Both link the binaries onto PATH, so there is no path.zsh.inc
# to source the way the old ~/Downloads tarball install needed.
for gcloud_inc in /usr/share/google-cloud-sdk/completion.zsh.inc \
                  "$HOMEBREW_PREFIX/share/google-cloud-sdk/completion.zsh.inc"; do
  [[ -f "$gcloud_inc" ]] && source "$gcloud_inc" && break
done
unset gcloud_inc

export PATH=$HOME/.npm-global/bin:$PATH

[[ -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm"

# gws token wrapper — auto-refreshes OAuth token on every call
gws() {
    GOOGLE_WORKSPACE_CLI_TOKEN="$(gcloud auth application-default print-access-token)" command gws "$@"
}

# Per-machine settings that do not belong in the bootstrap repo: account ids,
# work-specific endpoints, anything tied to one host. Sourced last so it can
# override anything above. Absent on a fresh machine, which is fine.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
