[color]
  ui = true
  branch = true
  diff = true
  status = true
[user]
	email = lbragsta@redhat.com
	name = Lance Bragstad
	signingkey = /home/lbragstad/.ssh/id_ecdsa_redhat.pub
[core]
  editor = nvim
  excludesfile = /home/lancebragstad/.gitignore_global
  excludefiles = /home/lbragstad/.gitignore
	pager = delta
[merge]
  tool = vimdiff
[gitreview]
  username = ldbragst
[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
  d = diff
  l = log
[safe]
	directory = /home/lbragstad/go/src/github.com/rhmdnd/stackrox
	directory = /home/lbragstad/go/src/github.com/rhmdnd/stackrox
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[url "git@github.com:"]
	insteadOf = https://github.com/
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[delta]
	plus-style = syntax "#1a501a"
	plus-non-emph-style = syntax "#1a501a"
	plus-emph-style = syntax "#2a802a"
	plus-empty-line-marker-style = normal "#1a501a"
[interactive]
        diffFilter = delta --color-only
